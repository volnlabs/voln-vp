cpu: CPU.ARMv8A @ sysbus
    cpuType: "cortex-a78"
    genericInterruptController: gic

timer: Timers.ARM_GenericTimer @ cpu
    frequency: 54000000
    EL3PhysicalTimerIRQ -> gic#0@29
    EL1PhysicalTimerIRQ -> gic#0@30
    EL1VirtualTimerIRQ -> gic#0@27
    NonSecureEL2PhysicalTimerIRQ -> gic#0@26
    NonSecureEL2VirtualTimerIRQ -> gic#0@28

gic: IRQControllers.ARM_GenericInterruptController @ {
        sysbus new Bus.BusMultiRegistration { address: 0x107fff9000; size: 0x1000; region: "distributor" };
        sysbus new Bus.BusMultiRegistration { address: 0x107fffa000; size: 0x2000; region: "cpuInterface" }
    }
    architectureVersion: .GICv2
    supportsTwoSecurityStates: true

ram: Memory.MappedMemory @ sysbus 0x0
    size: 0x200000000

uart0: UART.PL011 @ sysbus 0x107d001000
    -> gic@121

mailbox: Python.PythonPeripheral @ sysbus 0x107d00b880
    size: 0x40
    initable: true
    // Keep this small inline script aligned with the independently tested
    // backends/renode/peripherals/mailbox.py source. External Python filenames
    // are resolved relative to Renode's installation root, not this project.
    script: '''
READ = 0x00
READ_STATUS = 0x18
WRITE = 0x20
WRITE_STATUS = 0x38
EMPTY = 1 << 30

if request.IsInit:
    last_value = 0
    response_pending = False
elif request.IsWrite:
    if request.Offset == WRITE:
        last_value = request.Value
        response_pending = True
elif request.IsRead:
    if request.Offset == READ:
        request.Value = last_value if response_pending else 0
        response_pending = False
    elif request.Offset == READ_STATUS:
        request.Value = 0 if response_pending else EMPTY
    elif request.Offset == WRITE_STATUS:
        request.Value = 0
    else:
        request.Value = 0
'''
